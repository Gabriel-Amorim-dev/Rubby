 {
  "name": "rubby",
  "displayName": "Rubby",
  "description": "A cute pixel duck that keeps you company while you're coding.",
  "version": "0.1.0",
  "preview": true,
  "publisher": "Gabriel-Amorim-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gabriel-Amorim-dev/Rubby.git"
  },
  "homepage": "https://github.com/Gabriel-Amorim-dev/Rubby",
  "bugs": {
    "url": "https://github.com/Gabriel-Amorim-dev/Rubby/issues"
  },
  "engines": {
  "vscode": "^1.125.0"
  },
  "icon": "media/duck.png",
  "galleryBanner": {
    "color": "#7EC8E3",
    "theme": "light"
  },
  "categories": [
  "Other"
  ],
  "keywords": [
    "duck",
    "coding",
    "debugging",
    "fun",
    "productivity",
    "pet",
    "pixel-art"
  ],
  "activationEvents": [ "onStartupFinished" ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Rubby",
      "properties": {
        "rubby.sadThreshold": {
          "type": "number",
          "default": 10,
          "description": "Number of errors required for Rubby to become sad."
        },
        "rubby.scaredThreshold": {
          "type": "number",
          "default": 30,
          "description": "Number of errors required for Rubby to become scared."
        },
        "rubby.idleSleepMinutes": {
          "type": "number",
          "default": 5,
          "description": "Number of minutes of inactivity before Rubby falls asleep."
        }
      }
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "rubbyPanel",
          "title": "Rubby",
          "icon": "media/duck.png"
        }
      ]
    },
    "views": {
      "rubbyPanel": [
        {
          "icon":"media/duck.png",
          "id": "rubbyView",
          "name": "Rubby",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "rubby.configureThresholds",
        "title": "Rubby: Configure Thresholds"
      },
      {
        "command": "rubby.talk",
        "title": "Rubby: Talk to the Duck"
      },
      {
          "command": "rubby.testHappy",
          "title": "Rubby: Test Happy"
      },
      {
          "command": "rubby.testSad",
          "title": "Rubby: Test Sad"
      },
      {
          "command": "rubby.testScared",
          "title": "Rubby: Test Scared"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
